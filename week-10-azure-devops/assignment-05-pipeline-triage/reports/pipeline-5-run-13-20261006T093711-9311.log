
--- Run 13 / log 1 ---
trigger:
  enabled: false
variables:
- name: frontendPublicIp
  value: '20.84.49.29'
- name: backendPublicIp
  value: '20.127.125.150'
- name: backendPrivateIp
  value: '10.10.2.4'
- name: mysqlFqdn
  value: 'epicbook-michael-c3-2026.mysql.database.azure.com'
stages:
- stage: __default
  jobs:
  - job: Job
    pool:
      name: SelfHostedPool
    steps:
    - task: 6d15af64-176c-496d-b583-fd2ae21d4df4@1
      inputs:
        repository: self
        clean: true
    - task: DownloadSecureFile@1
      name: epicbookKey
      inputs:
        secureFile: week10_epicbook
    - task: Bash@3
      displayName: Install Ansible
      inputs:
        targetType: inline
        script: |
          set -euo pipefail
          python3 -m venv "$(Agent.TempDirectory)/epicbook-venv"
          "$(Agent.TempDirectory)/epicbook-venv/bin/python" -m pip install \
            'ansible-core-triage-intentionally-invalid>=2.19,<2.20'
          "$(Agent.TempDirectory)/epicbook-venv/bin/ansible-playbook" --version
    - task: Bash@3
      displayName: Configure servers and deploy EpicBook with Ansible
      env:
        SSH_KEY: $(epicbookKey.secureFilePath)
        FRONTEND_IP: $(frontendPublicIp)
        BACKEND_IP: $(backendPublicIp)
        BACKEND_PRIVATE_IP: $(backendPrivateIp)
        MYSQL_FQDN: $(mysqlFqdn)
      inputs:
        targetType: inline
        script: |
          set -euo pipefail
          umask 077
          cd "$(Build.SourcesDirectory)"

          archive="$(Agent.TempDirectory)/epicbook-app.tar.gz"
          known_hosts="$(Agent.TempDirectory)/epicbook-known-hosts"

          chmod 600 "$SSH_KEY"
          git archive --format=tar.gz --output="$archive" HEAD
          export APP_ARCHIVE="$archive"

          python3 - <<'PY'
          import json
          import os
          from pathlib import Path


          inventory = Path("ansible/inventory.ini.template").read_text()
          inventory = inventory.replace("FRONTEND_PUBLIC_IP", os.environ["FRONTEND_IP"])
          inventory = inventory.replace("BACKEND_PUBLIC_IP", os.environ["BACKEND_IP"])
          Path("ansible/inventory.ini").write_text(inventory)

          variables = Path("ansible/group_vars/all.yml.template").read_text()
          variables = variables.replace("MYSQL_FQDN", os.environ["MYSQL_FQDN"])
          variables = variables.replace("BACKEND_PRIVATE_IP", os.environ["BACKEND_PRIVATE_IP"])
          Path("ansible/group_vars/all.yml").write_text(variables)

              "app_archive": os.environ["APP_ARCHIVE"]
          }))
          PY

          export ANSIBLE_SSH_COMMON_ARGS="-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=$known_hosts"

          "$(Agent.TempDirectory)/epicbook-venv/bin/ansible-playbook" \
            -i ansible/inventory.ini \
            ansible/site.yml
    - task: Bash@3
      displayName: Verify EpicBook through Nginx
      inputs:
        targetType: inline
        script: |
          set -euo pipefail
          curl --fail --silent --show-error \
            --retry 12 --retry-delay 5 --retry-all-errors \
            --connect-timeout 10 --max-time 30 \
            --output "$(Agent.TempDirectory)/epicbook-home.html" \
            "http://$(frontendPublicIp)/"
          echo "EpicBook responded successfully at http://$(frontendPublicIp)/"


